apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: redis-data
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: redis, app.kubernetes.io/part-of: s1000-helper }
spec:
  accessModes: ["ReadWriteOnce"]
{% if storage_class %}
  storageClassName: {{ storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ redis_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: redis, app.kubernetes.io/part-of: s1000-helper }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app.kubernetes.io/name: redis }
  template:
    metadata:
      labels: { app.kubernetes.io/name: redis, app.kubernetes.io/part-of: s1000-helper }
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: redis
          image: {{ redis_image }}
          command: ["sh", "-c", "exec redis-server --appendonly yes --requirepass \"$REDIS_PASSWORD\""]
          env:
            - name: REDIS_PASSWORD
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: REDIS_PASSWORD } }
          ports:
            - containerPort: 6379
          readinessProbe:
            exec: { command: ["sh", "-c", "redis-cli -a \"$REDIS_PASSWORD\" --no-auth-warning ping | grep -q PONG"] }
            periodSeconds: 5
          livenessProbe:
            tcpSocket: { port: 6379 }
            initialDelaySeconds: 15
            periodSeconds: 15
          resources: {{ redis_resources | to_json }}
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: redis-data }
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: redis, app.kubernetes.io/part-of: s1000-helper }
spec:
  selector: { app.kubernetes.io/name: redis }
  ports:
    - name: redis
      port: 6379
      targetPort: 6379
