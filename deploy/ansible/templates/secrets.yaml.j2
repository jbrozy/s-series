apiVersion: v1
kind: Secret
metadata:
  name: s1000-helper-secrets
  namespace: {{ s1000_namespace }}
  labels:
    app.kubernetes.io/part-of: s1000-helper
type: Opaque
stringData:
  POSTGRES_DB: {{ postgres_db | to_json }}
  POSTGRES_USER: {{ postgres_user | to_json }}
  POSTGRES_PASSWORD: {{ postgres_password | to_json }}
  REDIS_PASSWORD: {{ redis_password | to_json }}
  DATABASE_URL: {{ ('postgres://' ~ (postgres_user | urlencode) ~ ':' ~ (postgres_password | urlencode) ~ '@postgres:5432/' ~ postgres_db ~ '?sslmode=disable') | to_json }}
  SCHECK_ADMIN_PASSWORD: {{ admin_password | to_json }}
  SCHECK_CHAT_API_KEY: {{ chat_api_key | to_json }}
  SCHECK_EMBED_API_KEY: {{ embed_api_key | to_json }}
  SCHECK_VISION_API_KEY: {{ vision_api_key | to_json }}
