apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: backend-data
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: backend, app.kubernetes.io/part-of: s1000-helper }
spec:
  accessModes: ["ReadWriteOnce"]
{% if storage_class %}
  storageClassName: {{ storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ data_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: backend, app.kubernetes.io/part-of: s1000-helper }
spec:
  # one replica: uploads live on a ReadWriteOnce volume, the job workers run in-process
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app.kubernetes.io/name: backend }
  template:
    metadata:
      labels: { app.kubernetes.io/name: backend, app.kubernetes.io/part-of: s1000-helper }
      annotations:
        # restart pods when configuration or secrets change
        checksum/config: {{ (lookup('ansible.builtin.template', 'configmap.yaml.j2') ~ lookup('ansible.builtin.template', 'secrets.yaml.j2')) | hash('sha256') }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        fsGroup: 10001
{% if image_pull_secret %}
      imagePullSecrets:
        - name: {{ image_pull_secret }}
{% endif %}
      containers:
        - name: backend
          image: {{ image_registry }}/s1000-helper-backend:{{ image_tag }}
          imagePullPolicy: {{ image_pull_policy }}
          ports:
            - name: http
              containerPort: 8080
          envFrom:
            - configMapRef: { name: s1000-helper-config }
          env:
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: DATABASE_URL } }
            - name: REDIS_PASSWORD
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: REDIS_PASSWORD } }
            - name: SCHECK_ADMIN_PASSWORD
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: SCHECK_ADMIN_PASSWORD } }
            - name: SCHECK_CHAT_API_KEY
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: SCHECK_CHAT_API_KEY } }
            - name: SCHECK_EMBED_API_KEY
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: SCHECK_EMBED_API_KEY } }
            - name: SCHECK_VISION_API_KEY
              valueFrom: { secretKeyRef: { name: s1000-helper-secrets, key: SCHECK_VISION_API_KEY } }
          startupProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /api/health, port: http }
            periodSeconds: 20
            failureThreshold: 6
          resources: {{ backend_resources | to_json }}
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: backend-data }
---
apiVersion: v1
kind: Service
metadata:
  name: backend
  namespace: {{ s1000_namespace }}
  labels: { app.kubernetes.io/name: backend, app.kubernetes.io/part-of: s1000-helper }
spec:
  selector: { app.kubernetes.io/name: backend }
  ports:
    - name: http
      port: 8080
      targetPort: http
