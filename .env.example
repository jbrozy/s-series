# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Port, unter dem S-Check erreichbar ist (http://localhost:8080)
SCHECK_PORT=8080

# Datenbank
POSTGRES_DB=scheck
POSTGRES_USER=scheck
POSTGRES_PASSWORD=bitte-aendern

# Redis (Sessions, Job-Queue, Modell-Cache)
REDIS_PASSWORD=bitte-aendern

# Benutzer: Selbstregistrierung erlauben? Der erste registrierte Benutzer wird Administrator.
SCHECK_ALLOW_SIGNUP=true
# Optional: Administrator beim Start anlegen
SCHECK_ADMIN_EMAIL=
SCHECK_ADMIN_PASSWORD=
# true setzen, wenn S-Check hinter HTTPS läuft
SCHECK_COOKIE_SECURE=false
SCHECK_WORKERS=2
SCHECK_MAX_UPLOAD_MB=2048

# ---- Modelle (Startwerte; später in Administration → Modelle änderbar)
# Jede OpenAI-kompatible API: Ollama (http://ollama:11434/v1), vLLM, LM Studio (http://host.docker.internal:1234/v1), OpenAI …
SCHECK_CHAT_BASE_URL=
SCHECK_CHAT_MODEL=
SCHECK_CHAT_API_KEY=
SCHECK_EMBED_BASE_URL=
SCHECK_EMBED_MODEL=
SCHECK_EMBED_API_KEY=
# Bildanalyse: none | heuristic | openai | http
SCHECK_VISION_PROVIDER=heuristic
SCHECK_VISION_BASE_URL=
SCHECK_VISION_MODEL=
SCHECK_VISION_API_KEY=
# Koordinatenformat der Vision-Antwort: norm1000 | pixel | norm1 | gemini
SCHECK_VISION_COORDS=norm1000
# Eigener Detektor-Dienst (provider=http)
SCHECK_DETECTOR_URL=
